# 国投证券 API Key（行情主数据源）
# sdicsc-market-query / sdicsc-smart-stock-selection / sdicsc-crowding-degree
GT_ZNXG_KEY=在此填入你的API Key

# 国投证券行业拥挤度 API Key（与 GT_ZNXG_KEY 相同即可）
GT_CROWDING_DEGREE_API_KEY=在此填入你的API Key

# 国信证券 API Key（财务/宏观辅助数据源）
# gs-stock-market-query / gs-stock-financial-query / gs-economy-query / gs-smart-stock-picking
GS_API_KEY=在此填入你的API Key

# 可选：DeepSeek（研报 LLM 格式化；不填则只用规则模板）
DEEPSEEK_API_KEY=

# 可选：微信机器人告警（scheduler 完成后推送）
WEIXIN_BOT_TOKEN=
# WEIXIN_ENDPOINT=https://ilinkai.weixin.qq.com
